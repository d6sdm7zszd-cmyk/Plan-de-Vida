  await renderRosaryPanel();
  document.getElementById('rosary-overlay').classList.add('show');
}
function fecharRosary(){
  autoRosaryActive = false;
  hailMaryLoopActive = false;
  stopSpeaking();
  document.getElementById('rosary-overlay').classList.remove('show');
}

async function renderRosaryPanel(){
  const panel = document.getElementById('rosary-panel-content');
  const set = getTodayMysterySet();
  const dKey = todayKey();
  const prayed = await getRosaryEntry(dKey);
  const mode = config.rosary.mode;

  panel.innerHTML = `
    <div class="modal-title">Santo Rosário</div>
    <div class="rosary-set-name">Hoje: ${set.name}</div>
    <div class="rem-note" style="margin-bottom:14px;">As meditações abaixo são um resumo breve, próprio desta app. Para as meditações completas de são Josemaria sobre cada mistério, tal como estão na página oficial do Opus Dei: <a href="https://opusdei.org/es-es/article/textos-de-san-josemaria-sobre-los-misterios-del-rosario/" target="_blank" rel="noopener" style="color:var(--gold);">ler aqui ↗</a></div>

    <div class="prayer-row">
      <button class="prayer-btn" data-prayer="padrenuestro">🔊 Pai Nosso</button>
      <button class="prayer-btn" id="avemaria-btn" data-prayer="avemaria">🔊 Ave Maria</button>
      <button class="prayer-btn" data-prayer="gloria">🔊 Glória</button>
    </div>

    <button class="listen-btn" id="auto-rosary-btn" style="width:100%;margin-bottom:6px;padding:11px;font-size:12.5px;">🚗 Modo mãos livres (rezar tudo automaticamente)</button>
    <div class="rem-note" id="auto-status" style="text-align:center;min-height:14px;margin-bottom:14px;">Ideal para o carro ou enquanto caminhas: reproduz em voz alta cada mistério, o Pai Nosso, as dez Ave Marias e o Glória, um após outro.</div>

    <div class="mode-toggle">
      <button class="mode-btn ${mode==='session'?'active':''}" data-mode="session">Sessão completa</button>
      <button class="mode-btn ${mode==='spread'?'active':''}" data-mode="spread">Distribuído ao longo do dia</button>
    </div>

    <div class="rosary-progress">${prayed.length}/5 mistérios rezados hoje</div>

    ${set.list.map((m,i)=>{
      const done = prayed.includes(i);
      return `<div class="mystery-card ${done?'done':''}">
        <div class="mystery-head">
          <div class="mystery-num">${i+1}º</div>
          <div class="mystery-title ${done?'done':''}">${escapeHtml(m.title)}</div>
          <div class="myst-box ${done?'done':''}" data-mystery-idx="${i}" title="Marcar como rezado"></div>
        </div>
        <div class="mystery-text">${escapeHtml(m.text)}</div>
        <div class="mystery-actions">
          ${mode==='spread' ? `<input type="time" class="mystery-time" data-time-idx="${i}" value="${config.rosary.times[i]||''}" />` : ''}
          <button class="listen-btn" data-speak="${i}">🔊 Ouvir meditação</button>
        </div>
      </div>`;
    }).join('')}

    ${mode==='spread' ? `
      <div class="rem-toggle-row">
        <div>
          <div class="section-title" style="font-size:15px;">Lembretes do Rosário</div>
          <div class="section-sub">avisa a cada hora programada</div>
        </div>
        <label class="rem-switch">
          <input type="checkbox" id="rosary-rem-enabled" ${config.rosary.remindersEnabled?'checked':''} />
          <span></span>
        </label>
      </div>
      <div class="rem-note">Ao chegar cada hora, avisa (vibração/aviso) para rezar esse mistério. Funciona enquanto esta aba continuar aberta.</div>
    ` : ''}

    <div class="modal-actions" style="margin-top:16px;">
      <button class="modal-fechar" id="rosary-fechar-btn">fechar</button>
    </div>
  `;

  document.getElementById('rosary-fechar-btn').addEventListener('click', fecharRosary);

  panel.querySelectorAll('.prayer-btn').forEach(btn=>{
    btn.addEventListener('click', (e)=>{
      const prayerKey = e.currentTarget.dataset.prayer;
      if(prayerKey === 'avemaria'){
        playHailMaryLoop(e.currentTarget);
      } else {
        hailMaryLoopActive = false;
        speak(PRAYERS[prayerKey]);
      }
    });
  });

  const autoBtn = document.getElementById('auto-rosary-btn');
  if(autoBtn){
    autoBtn.addEventListener('click', startAutoRosary);
  }

  panel.querySelectorAll('.mode-btn').forEach(btn=>{
    btn.addEventListener('click', async (e)=>{
      config.rosary.mode = e.currentTarget.dataset.mode;
      await saveConfig();
      renderRosaryPanel();
    });
  });

  panel.querySelectorAll('[data-mystery-idx]').forEach(el=>{
    el.addEventListener('click', async (e)=>{
      autoRosaryActive = false;
      hailMaryLoopActive = false;
      stopSpeaking();
      await toggleRosaryMystery(+e.currentTarget.dataset.mysteryIdx);
      renderRosaryPanel();
      render();
    });
  });

  panel.querySelectorAll('[data-speak]').forEach(btn=>{
    btn.addEventListener('click', (e)=>{
      autoRosaryActive = false;
      hailMaryLoopActive = false;
      const idx = +e.currentTarget.dataset.speak;
      const m = set.list[idx];
      speak(`${m.title}. ${m.text}`);
    });
  });

  panel.querySelectorAll('[data-time-idx]').forEach(inp=>{
    inp.addEventListener('change', async (e)=>{
      config.rosary.times[+e.target.dataset.timeIdx] = e.target.value;
      await saveConfig();
    });
  });

  const rosaryRem = document.getElementById('rosary-rem-enabled');
  if(rosaryRem){
    rosaryRem.addEventListener('change', async (e)=>{
      config.rosary.remindersEnabled = e.target.checked;
      if(config.rosary.remindersEnabled && !config.rosary.permissionAsked){
        config.rosary.permissionAsked = true;
        try{
          if('Notification' in window && Notification.permission === 'default'){
            await Notification.requestPermission();
          }
        }catch(err){}
      }
      await saveConfig();
    });
  }
}

// Reza el Ave María 10 veces seguidas en voz alta, mostrando el conteo
// en el propio botón. Tocarlo de nuevo mientras suena lo detiene.
async function playHailMaryLoop(btn){
  if(hailMaryLoopActive){
    hailMaryLoopActive = false;
    stopSpeaking();
    btn.textContent = '🔊 Ave Maria';
    return;
  }
  autoRosaryActive = false; // no mezclar con el modo automático completo
  hailMaryLoopActive = true;
  for(let i=1; i<=10; i++){
    if(!hailMaryLoopActive) break;
    btn.textContent = `🔊 Ave Maria (${i}/10)`;
    await speakAsync(PRAYERS.avemaria);
    await wait(250);
  }
  hailMaryLoopActive = false;
  btn.textContent = '🔊 Ave Maria';
}

// Marca visualmente una tarjeta de misterio como rezada sin volver a
// renderizar todo el panel (para no cortar el modo automático).
function markMysteryDoneVisually(idx){
  const cards = document.querySelectorAll('#rosary-panel-content .mystery-card');
  const card = cards[idx];
  if(!card) return;
  card.classList.add('done');
  const box = card.querySelector('.myst-box');
  if(box) box.classList.add('done');
  const title = card.querySelector('.mystery-title');
  if(title) title.classList.add('done');
}

// Modo manos libres: recorre los 5 misterios de hoy reproduciendo en
// voz alta la meditación, el Padre Nuestro, las diez Ave Marías (con
// conteo en pantalla) y el Gloria de cada uno, en secuencia. Pensado
// para usarse en el carro o caminando, sin tocar el teléfono.
async function startAutoRosary(){
  const btn = document.getElementById('auto-rosary-btn');
  const statusEl = document.getElementById('auto-status');

  if(autoRosaryActive){
    autoRosaryActive = false;
    stopSpeaking();
    if(btn) btn.textContent = '🚗 Modo mãos livres (rezar tudo automaticamente)';
    if(statusEl) statusEl.textContent = 'Modo automático parado.';
    return;
  }

  hailMaryLoopActive = false;
  autoRosaryActive = true;
  if(btn) btn.textContent = '⏹ Parar modo automático';
  const set = getTodayMysterySet();

  for(let i=0; i<set.list.length; i++){
    if(!autoRosaryActive) break;
    const m = set.list[i];

    if(statusEl) statusEl.textContent = `${i+1}º mistério: ${m.title} — meditação`;
    await speakAsync(`${m.title}. ${m.text}`);
    if(!autoRosaryActive) break;
    await wait(400);

    if(statusEl) statusEl.textContent = `${i+1}º mistério — Pai Nosso`;
    await speakAsync(PRAYERS.padrenuestro);
    if(!autoRosaryActive) break;
    await wait(300);

    for(let h=1; h<=10; h++){
      if(!autoRosaryActive) break;
      if(statusEl) statusEl.textContent = `${i+1}º mistério — Ave Maria (${h}/10)`;
      await speakAsync(PRAYERS.avemaria);
      await wait(200);
    }
    if(!autoRosaryActive) break;

    if(statusEl) statusEl.textContent = `${i+1}º mistério — Glória`;
    await speakAsync(PRAYERS.gloria);
    if(!autoRosaryActive) break;

    await markRosaryMysteryDone(i);
    markMysteryDoneVisually(i);
    const progressEl = document.querySelector('#rosary-panel-content .rosary-progress');
    if(progressEl){
      const prayedNow = await getRosaryEntry(todayKey());
      progressEl.textContent = `${prayedNow.length}/5 mistérios rezados hoje`;
    }
    render();
    await wait(600);
  }

  const finished = autoRosaryActive;
  autoRosaryActive = false;
  if(btn) btn.textContent = '🚗 Modo mãos livres (rezar tudo automaticamente)';
  if(statusEl) statusEl.textContent = finished
    ? 'Rosário completo. Que Deus te abençoe. 🙏'
    : 'Modo automático parado.';
}

// Panel de "Racha anual": recorre mes a mes desde el último 19 de
// marzo (fiesta de San José) hasta hoy, calculando el % de
// cumplimiento diario de cada mes y cuántos meses seguidos estuvieron
// completos al 100% cada día.
async function openAnnualHistory(){
  const overlay = document.getElementById('annual-overlay');
  const panel = document.getElementById('annual-panel-content');
  panel.innerHTML = `<div class="modal-title">Sequência anual</div><div class="mystery-text">A calcular o teu histórico…</div>`;
  overlay.classList.add('show');

  const now = new Date();
  let sjYear = now.getFullYear();
  const marchNineteen = new Date(sjYear, 2, 19);
  if(now < marchNineteen) sjYear -= 1;
  const startDate = new Date(sjYear, 2, 19);

  const months = [];
  let cursor = new Date(startDate.getFullYear(), startDate.getMonth(), 1);
  const endCursor = new Date(now.getFullYear(), now.getMonth(), 1);
  while(cursor <= endCursor){
    months.push(new Date(cursor));
    cursor.setMonth(cursor.getMonth()+1);
  }

  const monthResults = [];
  for(const mDate of months){
    const year = mDate.getFullYear();
    const month = mDate.getMonth();
    const isStartMonth = (year===startDate.getFullYear() && month===startDate.getMonth());
    const isCurrentMonth = (year===now.getFullYear() && month===now.getMonth());
    const firstDay = isStartMonth ? startDate.getDate() : 1;
    const lastDay = isCurrentMonth ? now.getDate() : new Date(year, month+1, 0).getDate();

    let sum=0, count=0, fullDays=0;
    for(let day=firstDay; day<=lastDay; day++){
      const d = new Date(year, month, day);
      const entry = await getEntry('daily', todayKey(d));
      const pct = config.daily.length ? entry.length/config.daily.length : 0;
      sum += pct; count++;
      if(pct>=1) fullDays++;
    }
    monthResults.push({
      label: `${MONTH_NAMES[month]} ${year}`,
      avgPct: count ? sum/count : 0,
      fullDays, totalDays: count,
      kept: count>0 && fullDays===count
    });
  }

  let streak = 0;
  for(const m of monthResults){
    if(m.kept) streak++; else break;
  }

  panel.innerHTML = `
    <div class="modal-title">Sequência anual</div>
    <div class="rosary-set-name">Desde 19 de março de ${startDate.getFullYear()}</div>
    <div class="rosary-progress">${streak} ${streak===1?'mês completo':'meses completos'} seguidos</div>
    ${monthResults.slice().reverse().map(m=>`
      <div class="mystery-card ${m.kept?'done':''}">
        <div class="mystery-head">
          <div class="mystery-title ${m.kept?'done':''}" style="text-transform:capitalize;">${escapeHtml(m.label)}</div>
        </div>
        <div class="mystery-text">${Math.round(m.avgPct*100)}% de cumprimento médio · ${m.fullDays}/${m.totalDays} dias a 100%</div>
      </div>
    `).join('')}
    <div class="modal-actions" style="margin-top:16px;">
      <button class="modal-fechar" id="annual-fechar-btn">fechar</button>
    </div>
  `;
  document.getElementById('annual-fechar-btn').addEventListener('click', fecharAnnualHistory);
}
function fecharAnnualHistory(){
  document.getElementById('annual-overlay').classList.remove('show');
}

// Panel de jaculatorias: la comunión espiritual, el audio oficial de
